{
  "manifest_version": 3,
  "name": "PriceCompare",
  "version": "1.0.0",
  "description": "Compare electronics prices from your browser toolbar.",
  "action": { "default_title": "PriceCompare", "default_popup": "popup.html" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"]
}
